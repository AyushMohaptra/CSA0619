import math


def closest_pair(P):
  P = sorted(P, key=lambda p: p[0])
  if len(P) <= 3:
    return min(
        (
            math.hypot(a[0] - b[0], a[1] - b[1])
            for i, a in enumerate(P)
            for b in P[i + 1 :]
        ),
        default=float("inf"),
    )
  mid = len(P) // 2
  d = min(closest_pair(P[:mid]), closest_pair(P[mid:]))
  strip = [p for p in P if abs(p[0] - P[mid][0]) < d]
  return min(
      d,
      min(
          (
              math.hypot(strip[i][0] - strip[j][0], strip[i][1] - strip[j][1])
              for i in range(len(strip))
              for j in range(i + 1, min(i + 8, len(strip)))
          ),
          default=d,
      ),
  )
